# Copy to .env (never commit .env). Values are placeholders.

# Context7 — optional, raises rate limits. https://context7.com/dashboard
CONTEXT7_API_KEY=

# 21st.dev — required for the "21st" MCP server (HTTP). Free key: https://21st.dev/mcp
API_KEY_21ST=

# Strix — LLM used by the security scanner (Phase 5)
STRIX_LLM=
LLM_API_KEY=

# Database scripts (packages/db) — local development only; production values live in CI secrets.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
HANTEX_ADMIN_APP_PASSWORD=
HANTEX_PUBLIC_APP_PASSWORD=
HANTEX_BUILD_PASSWORD=
HANTEX_BACKUP_PASSWORD=
