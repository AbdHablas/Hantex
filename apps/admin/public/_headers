# Security headers for the dashboard's static files (docs/security.md). API responses set their
# own headers in apps/api/src/middleware/security.ts. form-action and frame-src allow https:
# because draft previews post a signed form to each site's own address, in a new tab or in the
# page editor's device preview frame (src/components/builder/DevicePreview.tsx). Each site in
# turn lets only the dashboard frame its previews (DASHBOARD_ORIGIN).
# blob: images and connections let the 3D Studio's viewer read a model's embedded textures
# (src/components/ModelViewer.tsx); only scripts already running on the page can make blob: addresses.
# The style-src hash allows exactly one inline stylesheet: the viewer's own (@google/model-viewer
# 4.4.0). The dashboard's browser test fails on any CSP violation, so an upgrade that changes it shows.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https:; connect-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'sha256-PXtZZkJMMyc18o/DN1ZEFOJ2qEGq95IQbVaJFMOXOb0='; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self' https:; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), publickey-credentials-create=(self), publickey-credentials-get=(self)
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
