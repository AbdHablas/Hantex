---
import { themeToCss } from '@hantex/theme';
import { env } from 'cloudflare:workers';
import { renderContext } from '../builder';
import ComingSoonPage from '../components/ComingSoonPage.astro';
import LivePage from '../components/LivePage.astro';
import { frameAncestors, verifyPreview } from '../server/preview';
import { SITE } from '../site-data';

/**
 * Draft preview, posted by the dashboard as a signed form: the Coming Soon page, or one page of
 * the website builder (D-035). Never cached or indexed; the draft theme's stylesheet is inlined
 * with a per-response nonce. Only the dashboard may show it in a frame (its device preview).
 */
export const prerender = false;

let data = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  data = await verifyPreview(
    env.PREVIEW_SIGNING_SECRET,
    {
      payload: String(form.get('payload') ?? ''),
      expires: String(form.get('expires') ?? ''),
      signature: String(form.get('signature') ?? ''),
    },
    SITE.site.key,
  );
}
const lang = new URL(Astro.request.url).searchParams.get('lang');
const nonce = crypto.randomUUID().replace(/-/g, '');
const page = data?.builder && data.page && data.builder.pages[data.page.id] ? data.page : null;
const locale =
  SITE.site.locales.find((l) => l === (page?.locale ?? lang)) ?? SITE.site.defaultLocale;
const ctx =
  data?.builder && page
    ? renderContext({
        locale,
        locales: SITE.site.locales,
        defaultLocale: SITE.site.defaultLocale,
        content: { ...data.builder, media: data.media ?? {} },
        settings: data['site-settings'],
        preview: true,
      })
    : null;

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
if (data) {
  Astro.response.headers.set(
    'Content-Security-Policy',
    `default-src 'self'; style-src 'self' 'nonce-${nonce}'; script-src 'self'; img-src 'self' data:; font-src 'self'; frame-ancestors ${frameAncestors(env.DASHBOARD_ORIGIN)}; base-uri 'none'; form-action 'none'`,
  );
} else {
  Astro.response.status = 403;
}
---

{
  data && ctx && page ? (
    <LivePage ctx={ctx} pageId={page.id} themeCss={{ css: themeToCss(data.theme), nonce }} theme={data.theme} />
  ) : data ? (
    <ComingSoonPage
      locale={locale}
      content={data['coming-soon']}
      settings={data['site-settings']}
      preview
      themeCss={{ css: themeToCss(data.theme), nonce }}
      theme={data.theme}
    />
  ) : (
    <p>Preview link expired or invalid.</p>
  )
}
