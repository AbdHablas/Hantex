---
import type { SectionOf } from '@hantex/sections';
import { pick, pictureOf, type RenderContext } from '../../builder';
import Button from './Button.astro';
import Heading from './Heading.astro';
import Picture from './Picture.astro';

interface Props {
  section: SectionOf<'imageText'>;
  ctx: RenderContext;
  headingId: string;
}
const { section, ctx, headingId } = Astro.props;
const s = section.settings;
const picture = pictureOf(ctx, s.image);
---

<div class:list={['bx-split', `img-${s.imageSide}`, { 'no-img': !picture }]}>
  {picture && <Picture picture={picture} sizes="(min-width: 48rem) 36rem, 100vw" class="bx-split-img" />}
  <div class="bx-split-text">
    <Heading ctx={ctx} title={s.title} id={headingId} />
    {pick(ctx, s.text) && <p class="bx-intro">{pick(ctx, s.text)}</p>}
    <div class="bx-actions">
      <Button button={s.button} ctx={ctx} />
    </div>
  </div>
</div>
