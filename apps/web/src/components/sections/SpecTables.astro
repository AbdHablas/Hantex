---
import { formatValue, specGroups, type ShowcaseProduct } from '@hantex/sections';
import { pick, type RenderContext } from '../../builder';
import { TEXT } from '../../i18n';

/**
 * A product's specification tables (D-048), made only from the values entered in the catalogue:
 * an attribute without a value isn't shown, and nothing is ever filled in for it. Optionally its
 * product codes, each with its finish or name.
 */
interface Props {
  product: ShowcaseProduct;
  ctx: RenderContext;
  showCodes: boolean;
}
const { product, ctx, showCodes } = Astro.props;
const t = TEXT[ctx.locale];
const showcase = ctx.content.showcase!;
const words = { yes: t.yes, no: t.no };
const groups = specGroups(showcase, product)
  .map((g) => ({
    name: g.name ? pick(ctx, g.name) : t.otherSpecs,
    rows: g.attributes
      .map((a) => ({ id: a.id, name: pick(ctx, a.name), value: formatValue(a, product.values[a.id], ctx.locale, words) }))
      .filter((r) => r.name && r.value),
  }))
  .filter((g) => g.rows.length > 0);
const finishName = (id: string | null) => {
  const finish = id ? showcase.finishes.find((f) => f.id === id) : undefined;
  return finish ? pick(ctx, finish.name) : '';
};
const codes = showCodes
  ? product.variants.filter((v) => v.sku).map((v) => ({ sku: v.sku, name: pick(ctx, v.name) || finishName(v.finishId) }))
  : [];
const productName = pick(ctx, product.name);
---

{
  (groups.length > 0 || codes.length > 0) && (
    <div class="bx-specs">
      {groups.map((g) => (
        <table class="bx-table">
          <caption>{g.name}</caption>
          <tbody>
            {g.rows.map((r) => (
              <tr>
                <th scope="row">{r.name}</th>
                <td>{r.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ))}
      {codes.length > 0 && (
        <table class="bx-table">
          <caption>
            {t.productCodes}
            {productName && <span class="sr-only"> — {productName}</span>}
          </caption>
          <thead>
            <tr>
              <th scope="col">{t.code}</th>
              <th scope="col">{t.variant}</th>
            </tr>
          </thead>
          <tbody>
            {codes.map((c) => (
              <tr>
                <td dir="ltr" class="bx-code">{c.sku}</td>
                <td>{c.name}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  )
}
