---
import type { SectionOf } from '@hantex/sections';
import { hrefOf, pick, type RenderContext } from '../../builder';
import Icon from '../Icon.astro';
import Heading from './Heading.astro';

interface Props {
  section: SectionOf<'cards'>;
  ctx: RenderContext;
  headingId: string;
}
const { section, ctx, headingId } = Astro.props;
const s = section.settings;
const items = s.items
  .filter((i) => pick(ctx, i.title))
  .map((i) => ({ ...i, target: hrefOf(ctx, i.link) }));
---

<Heading ctx={ctx} title={s.title} intro={s.intro} id={headingId} />
{
  items.length > 0 && (
    <ul class:list={['bx-grid', `cols-${s.columns}`]}>
      {items.map((item) => (
        <li class:list={['bx-card', { 'is-link': item.target }]}>
          <span class="bx-icon">
            <Icon name={item.icon} />
          </span>
          <h3>
            {item.target ? (
              <a href={item.target.href} rel={item.target.external ? 'noopener' : undefined}>
                {pick(ctx, item.title)}
              </a>
            ) : (
              pick(ctx, item.title)
            )}
          </h3>
          {pick(ctx, item.text) && <p>{pick(ctx, item.text)}</p>}
          {item.target && <Icon name="chevron" class="bx-card-arrow" />}
        </li>
      ))}
    </ul>
  )
}
