---
import { productsFor, type SectionOf } from '@hantex/sections';
import type { RenderContext } from '../../builder';
import Button from './Button.astro';
import Heading from './Heading.astro';
import ProductGrid from './ProductGrid.astro';

/** Products from the catalogue (D-048): all, a category's, a series' or hand-picked. */
interface Props {
  section: SectionOf<'products'>;
  ctx: RenderContext;
  headingId: string;
}
const { section, ctx, headingId } = Astro.props;
const s = section.settings;
const products = ctx.content.showcase ? productsFor(ctx.content.showcase, s) : [];
---

<Heading ctx={ctx} title={s.title} intro={s.intro} id={headingId} />
<ProductGrid
  products={products}
  ctx={ctx}
  columns={s.columns}
  layout={s.layout}
  showSummary={s.showSummary}
  showFinishes={s.showFinishes}
/>
<div class="bx-actions"><Button button={s.button} ctx={ctx} /></div>
