---
import type { SectionOf } from '@hantex/sections';
import type { RenderContext } from '../../builder';
import Heading from './Heading.astro';
import SpecTables from './SpecTables.astro';

/** A product's specification table (D-048), from its catalogue values. */
interface Props {
  section: SectionOf<'specs'>;
  ctx: RenderContext;
  headingId: string;
}
const { section, ctx, headingId } = Astro.props;
const s = section.settings;
const product = ctx.content.showcase?.products.find((p) => p.id === s.productId);
---

<Heading ctx={ctx} title={s.title} id={headingId} />
{product && <SpecTables product={product} ctx={ctx} showCodes={s.showCodes} />}
