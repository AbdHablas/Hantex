---
import type { Theme } from '@hantex/theme';
import { pageHref, pick, resolveSections, shareOf, type RenderContext } from '../builder';
import { siteLd } from '../structured';
import { SITE } from '../site-data';
import Section from './sections/Section.astro';
import SiteLayout from './SiteLayout.astro';

/**
 * A page made with the website builder (D-035): its sections in order, inside the site's frame.
 * Used for published pages and for draft previews.
 */
interface Props {
  ctx: RenderContext;
  pageId: string;
  /** A draft theme's stylesheet, inlined with a nonce (previews only). */
  themeCss?: { css: string; nonce: string };
  theme?: Theme;
}

const { ctx, pageId, themeCss, theme } = Astro.props;
const { preview, settings } = ctx;
const page = ctx.pages.get(pageId)!;
const site = SITE.site;
const siteName = site.name[ctx.locale] || site.name.ar || site.name.en;
const origin = site.primaryDomain ? `https://${site.primaryDomain}` : null;
const isHome = pageId === ctx.content.index.home;

const pageTitle = pick(ctx, page.title);
const title = pick(ctx, page.seo.title) || (isHome ? pick(ctx, settings.seo.title) || siteName : `${pageTitle} — ${siteName}`);
const description = pick(ctx, page.seo.description) || (isHome ? pick(ctx, settings.seo.description) : '');
const noindex = preview || page.seo.noindex;
// The page's own sharing picture (D-044) when it has one; otherwise the site's share card.
const share = page.seo.image ? shareOf(ctx, page.seo.image, origin) : null;
const sections = resolveSections(ctx, page);
const firstHero = sections.find((s) => s.type === 'hero' && pick(ctx, s.settings.heading));
---

<SiteLayout
  ctx={ctx}
  title={title}
  description={description}
  noindex={noindex}
  share={share}
  hrefFor={(l) => pageHref(ctx, pageId, l)}
  themeCss={themeCss}
  theme={theme}
  structured={isHome && origin ? siteLd(ctx, SITE, origin) : []}
>
  {!firstHero && <h1 class="sr-only">{pageTitle || siteName}</h1>}
  {sections.map((section) => <Section section={section} ctx={ctx} main={section === firstHero} />)}
</SiteLayout>
