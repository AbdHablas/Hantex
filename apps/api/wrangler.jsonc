// Dashboard Worker "hantex-admin" (docs/deployment.md). Not deployed: deployment, the custom
// domain and Cloudflare Access are set up only with the owner's approval.
// Secrets (BETTER_AUTH_SECRET, TOKEN_HASH_SECRET, PREVIEW_SIGNING_SECRET, TURNSTILE_SECRET_KEY,
// RESEND_API_KEY, PUBLISH_*) are Worker secrets, never in this file.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hantex-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // node-postgres needs Node.js APIs (net, tls) on Workers.
  "compatibility_flags": ["nodejs_compat"],
  // The unfinished dashboard must never be reachable on a *.workers.dev address or a preview
  // URL: it is served only on its own domain, behind Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Placeholder: replaced with the real Hyperdrive configuration id (caching disabled) at
      // deployment. Locally, `wrangler dev` uses localConnectionString.
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://hantex_admin_app@127.0.0.1:54329/postgres",
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://admin.hantexultra.com",
  },
}
