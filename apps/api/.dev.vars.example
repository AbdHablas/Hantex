# Copy to .dev.vars for `pnpm --filter @hantex/api dev`. Never commit .dev.vars.
# Generate local-only values, e.g. `openssl rand -base64 32`. Production values are Worker secrets.
ENVIRONMENT=development
APP_ORIGIN=http://localhost:8787
BETTER_AUTH_SECRET=
TOKEN_HASH_SECRET=
PREVIEW_SIGNING_SECRET=
EMAIL_FROM=
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
